local function updatePlayerESP(targetPlayer)
	if targetPlayer == player then return end

	local function setupCharESP(character)
		if not character then return end

		local highlight = character:FindFirstChild("UltraESP")
		if not highlight then
			highlight = Instance.new("Highlight")
			highlight.Name = "UltraESP"
			highlight.FillColor = Color3.fromRGB(0, 255, 180)
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			highlight.FillTransparency = 0.5
			highlight.OutlineTransparency = 0
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Parent = character
		end
		highlight.Enabled = espEnabled

		local head = character:WaitForChild("Head", 3)
		if head then
			local bb = head:FindFirstChild("UltraESPName")
			if not bb then
				bb = Instance.new("BillboardGui")
				bb.Name = "UltraESPName"
				bb.Size = UDim2.new(0, 150, 0, 30)
				bb.StudsOffset = Vector3.new(0, 2.5, 0)
				bb.AlwaysOnTop = true

				local nameLabel = Instance.new("TextLabel")
				nameLabel.Size = UDim2.new(1, 0, 1, 0)
				nameLabel.BackgroundTransparency = 1
				nameLabel.Text = targetPlayer.Name
				nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
				nameLabel.TextStrokeTransparency = 0
				nameLabel.Font = Enum.Font.GothamBold
				nameLabel.TextSize = 13
				nameLabel.Parent = bb

				bb.Parent = head
			end
			bb.Enabled = espEnabled
		end
	end

	if targetPlayer.Character then setupCharESP(targetPlayer.Character) end
	targetPlayer.CharacterAdded:Connect(setupCharESP)
end

local function toggleESPState(state)
	espEnabled = state
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			local hl = p.Character:FindFirstChild("UltraESP")
			if hl then hl.Enabled = espEnabled end
			local head = p.Character:FindFirstChild("Head")
			if head then
				local bb = head:FindFirstChild("UltraESPName")
				if bb then bb.Enabled = espEnabled end
			end
		end
	end
end

for _, p in ipairs(Players:GetPlayers()) do updatePlayerESP(p) end
Players.PlayerAdded:Connect(updatePlayerESP)

