--------------------------------------------------------------------------------
local menuFlyToggleBtn

local function stopFlying()
	flying = false
	if bodyVelocity then bodyVelocity:Destroy() end
	if bodyGyro then bodyGyro:Destroy() end
	if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
		player.Character:FindFirstChildOfClass("Humanoid").PlatformStand = false
	end

	mobileUpBtn.Visible = false
	mobileDownBtn.Visible = false
	mobileUpPressed = false
	mobileDownPressed = false

	flyToggleBtn.Text = "🚀 เปิดบิน (FLY)"
	flyToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)

	if menuFlyToggleBtn then
		menuFlyToggleBtn.Text = "🚀 โหมดการบิน (FLY MODE): OFF"
		menuFlyToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
		menuFlyToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
	end
end

local function startFlying()
	local character = player.Character
	if not character then return end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid then return end

	flying = true
	humanoid.PlatformStand = true

	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
	bodyVelocity.Velocity = Vector3.zero
	bodyVelocity.Parent = hrp

	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
	bodyGyro.CFrame = hrp.CFrame
	bodyGyro.Parent = hrp

	flyToggleBtn.Text = "🛑 หยุดบิน (STOP)"
	flyToggleBtn.BackgroundColor3 = Color3.fromRGB(230, 40, 60)

	if menuFlyToggleBtn then
		menuFlyToggleBtn.Text = "🚀 โหมดการบิน (FLY MODE): ON"
		menuFlyToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
		menuFlyToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end

	if UserInputService.TouchEnabled then
		mobileUpBtn.Visible = true
		mobileDownBtn.Visible = true
	end

	task.spawn(function()
		while flying and character and hrp and humanoid do
			local camera = workspace.CurrentCamera
			local moveVector = Vector3.zero

			local moveDir = humanoid.MoveDirection
			if moveDir.Magnitude > 0 then
				local cameraCFrame = camera.CFrame
				moveVector = cameraCFrame:VectorToWorldSpace(cameraCFrame:VectorToObjectSpace(moveDir))
			end

			if moveKeys.W then moveVector = moveVector + camera.CFrame.LookVector end
			if moveKeys.S then moveVector = moveVector - camera.CFrame.LookVector end
			if moveKeys.A then moveVector = moveVector - camera.CFrame.RightVector end
			if moveKeys.D then moveVector = moveVector + camera.CFrame.RightVector end
			if moveKeys.E then moveVector = moveVector + Vector3.new(0, 1, 0) end
			if moveKeys.Q then moveVector = moveVector - Vector3.new(0, 1, 0) end

			if mobileUpPressed then moveVector = moveVector + Vector3.new(0, 1, 0) end
			if mobileDownPressed then moveVector = moveVector - Vector3.new(0, 1, 0) end

			if moveVector.Magnitude > 0 then
				moveVector = moveVector.Unit * flySpeed
			end

			bodyVelocity.Velocity = moveVector
			bodyGyro.CFrame = camera.CFrame
			RunService.RenderStepped:Wait()
		end
	end)
end

local function toggleFly()
	if flying then stopFlying() else startFlying() end
end

flyToggleBtn.MouseButton1Click:Connect(toggleFly)

